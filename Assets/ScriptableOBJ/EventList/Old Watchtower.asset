  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Old Watchtower
  m_EditorClassIdentifier: 
  eventTitle: Old Watchtower
  description: An old watchtower stands beside the road
  allLevels: 0
  minLevel: 1
  maxLevel: 2
  choices:
  - choiceText: Climb the Tower
    successChance: 50
    successOutcome:
      resultText: From the top, you spot a shorter route ahead
      fuelChange: -2
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The stairs collapse beneath you. and hit the truck, and you waste
        valuable time
      fuelChange: -10
      truckChange: -20
      cargoChange: 0
  - choiceText: Salvage Materials
    successChance: 20
    successOutcome:
      resultText: You recover sturdy metal parts from the structure
      fuelChange: 0
      truckChange: 15
      cargoChange: 0
    failureOutcome:
      resultText: The rusty metal breaks apart in your truck!
      fuelChange: 0
      truckChange: -10
      cargoChange: 0
  - choiceText: Ignore It
    successChance: 90
    successOutcome:
      resultText: You continue your journey
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You miss a warning sign and take a longer route
      fuelChange: -5
      truckChange: 0
      cargoChange: 0
