  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Friendly Traveler
  m_EditorClassIdentifier: 
  eventTitle: Friendly Traveler
  description: Another traveler asks for help
  allLevels: 0
  minLevel: 1
  maxLevel: 3
  choices:
  - choiceText: Help Them
    successChance: 30
    successOutcome:
      resultText: The traveler repaid your kindness!
      fuelChange: 10
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: They accepted your help and left! Are you expecting a return favor
        from that traveler?
      fuelChange: -10
      truckChange: 0
      cargoChange: 0
  - choiceText: Ignore Them
    successChance: 100
    successOutcome:
      resultText: Not your problem!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The traveler spread word about your selfishness!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
  - choiceText: Trade Supplies
    successChance: 40
    successOutcome:
      resultText: A fair trade!
      fuelChange: 20
      truckChange: 0
      cargoChange: -10
    failureOutcome:
      resultText: You got the short end of the deal! Womp Womp!
      fuelChange: 5
      truckChange: 0
      cargoChange: -20
