%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Beeping Briefcase
  m_EditorClassIdentifier: 
  eventTitle: Beeping Briefcase
  description: You find a locked briefcase sitting in the middle of the road. It's
    making a loud beeping sound. That's probably fine.
  allLevels: 0
  minLevel: 4
  maxLevel: 4
  choices:
  - choiceText: Open It
    successChance: 30
    successOutcome:
      resultText: The briefcase contains emergency fuel vouchers and spare parts
      fuelChange: 25
      truckChange: 15
      cargoChange: 0
    failureOutcome:
      resultText: The briefcase was a bomb. The explosion damages your truck and
        cargo
      fuelChange: 0
      truckChange: -20
      cargoChange: -20
  - choiceText: Throw It Away
    successChance: 70
    successOutcome:
      resultText: You toss the briefcase into a ditch. Moments later, it explodes
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: It explodes while you're moving it!
      fuelChange: 0
      truckChange: -15
      cargoChange: -15
  - choiceText: Leave Immediately
    successChance: 100
    successOutcome:
      resultText: You decide this is someone else's problem
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The scavengers were heavily armed. You barely escaped
      fuelChange: -10
      truckChange: -45
      cargoChange: -30
