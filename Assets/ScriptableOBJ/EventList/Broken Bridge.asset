%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Broken Bridge
  m_EditorClassIdentifier: 
  eventTitle: Broken Bridge
  description: oh no, the bridge is broken!
  allLevels: 1
  minLevel: 1
  maxLevel: 1
  choices:
  - choiceText: Look for a Detour
    successChance: 50
    successOutcome:
      resultText: You found the fastest detour!
      fuelChange: -7
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You found a detour after two hours, you wasted a lot of fuel!
      fuelChange: -20
      truckChange: 0
      cargoChange: 0
  - choiceText: Try Jumping
    successChance: 40
    successOutcome:
      resultText: Miraculously, you managed to jump with the truck!
      fuelChange: -5
      truckChange: -5
      cargoChange: -5
    failureOutcome:
      resultText: You jumped with the truck and damaged a lot of cargo and the truck
        itself!
      fuelChange: -5
      truckChange: -30
      cargoChange: -40
  - choiceText: Repair the Bridge
    successChance: 70
    successOutcome:
      resultText: You managed to find materials around the bridge and repair it!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You couldn't find materials to repair the bridge and were forced
        to use some of the cargo from the truck!
      fuelChange: 0
      truckChange: 0
      cargoChange: -50
