  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Heavy Rain
  m_EditorClassIdentifier: 
  eventTitle: Heavy Rain
  description: This rain is too heavy to continue.
  allLevels: 1
  minLevel: 1
  maxLevel: 1
  choices:
  - choiceText: Look for Shelter
    successChance: 50
    successOutcome:
      resultText: You found nearby shelter!
      fuelChange: -6
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You couldn't find shelter and wasted fuel searching!
      fuelChange: -20
      truckChange: 0
      cargoChange: 0
  - choiceText: Just push Through
    successChance: 40
    successOutcome:
      resultText: You try to push through the rain, and suddenly it stops!
      fuelChange: -10
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: you try to break through this rain and damage your cargo and truck!
      fuelChange: -10
      truckChange: -20
      cargoChange: -20
  - choiceText: Wait in the Rain
    successChance: 37
    successOutcome:
      resultText: You wait for the rain to stop in the middle of the rain, suddenly
        the rain stops!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You wait for the rain to stop in the middle of the rain, suddenly
        the rain gets heavier damaged the cargo!
      fuelChange: 0
      truckChange: 0
      cargoChange: -40
