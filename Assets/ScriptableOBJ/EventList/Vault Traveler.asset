--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Vault Traveler
  m_EditorClassIdentifier: 
  eventTitle: Vault Traveler
  description: A traveler wearing a blue jumpsuit marked "76" asks for a ride to
    a place called Vault 76.
  allLevels: 0
  minLevel: 3
  maxLevel: 4
  choices:
  - choiceText: Give Him a Ride
    successChance: 70
    successOutcome:
      resultText: The traveler thanks you and shares some emergency supplies before
        leaving
      fuelChange: 25
      truckChange: 0
      cargoChange: 5
    failureOutcome:
      resultText: The traveler gets carsick and damages part of your cargo
      fuelChange: 0
      truckChange: 0
      cargoChange: -10
  - choiceText: Ask About the Vault
    successChance: 70
    successOutcome:
      resultText: He gives you directions to a hidden supply cache
      fuelChange: 0
      truckChange: 20
      cargoChange: 0
    failureOutcome:
      resultText: He talks for hours about life underground
      fuelChange: -15
      truckChange: 0
      cargoChange: 0
  - choiceText: Refuse Politely
    successChance: 100
    successOutcome:
      resultText: He understands and walks away
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The scavengers were heavily armed. You barely escaped
      fuelChange: -10
      truckChange: -45
      cargoChange: -30
