  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Suspicious Shortcut
  m_EditorClassIdentifier: 
  eventTitle: Suspicious Shortcut
  description: A narrow road could save time!
  allLevels: 0
  minLevel: 3
  maxLevel: 5
  choices:
  - choiceText: Take the Shortcut
    successChance: 40
    successOutcome:
      resultText: The shortcut actually worked!
      fuelChange: -5
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The shortcut is full of potholes, causing cargo and trucks to shake
        violently!
      fuelChange: -10
      truckChange: -20
      cargoChange: -10
  - choiceText: Stay on Main Road
    successChance: 60
    successOutcome:
      resultText: Boring, but reliable!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You hit unexpected traffic and wasted fuel!
      fuelChange: -10
      truckChange: 0
      cargoChange: 0
  - choiceText: Scout Ahead
    successChance: 70
    successOutcome:
      resultText: You found a safer route!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The scouting trip accomplished nothing but loss on fuel!
      fuelChange: -5
      truckChange: 0
      cargoChange: 0
