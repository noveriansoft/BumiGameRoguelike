  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Muddy Road
  m_EditorClassIdentifier: 
  eventTitle: Muddy Road
  description: This will damage the tires
  allLevels: 0
  minLevel: 2
  maxLevel: 2
  choices:
  - choiceText: Just push Through
    successChance: 70
    successOutcome:
      resultText: You drove along a muddy road and managed to get out!
      fuelChange: -5
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You drove along a muddy road and damaged your truck!
      fuelChange: 0
      truckChange: -20
      cargoChange: 0
  - choiceText: Look for a Detour
    successChance: 70
    successOutcome:
      resultText: You found the fastest detour!
      fuelChange: -5
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You found a detour after two hours, you wasted a lot of fuel!
      fuelChange: -20
      truckChange: 0
      cargoChange: 0
  - choiceText: Wait until it dries
    successChance: 30
    successOutcome:
      resultText: You wait for the mud to dry and then pass through!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: You were waiting for the mud to dry, but suddenly it started raining
        and ruined your cargo.
      fuelChange: 0
      truckChange: 0
      cargoChange: -20
