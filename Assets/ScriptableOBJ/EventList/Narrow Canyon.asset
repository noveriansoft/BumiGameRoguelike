  - choiceText: Use the Main Road
    successChance: 70
    successOutcome:
      resultText: The route is longer but safe
      fuelChange: -10
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: A fallen rock forces an unexpected detour!
      fuelChange: -20
      truckChange: 0
      cargoChange: 0
  - choiceText: Clear the Path
    successChance: 50
    successOutcome:
      resultText: You remove enough debris to travel safely!
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
