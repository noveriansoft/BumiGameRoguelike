  eventTitle: Narrow Canyon
  description: A narrow canyon could save time, but the path looks unstable
  allLevels: 0
  minLevel: 3
  maxLevel: 4
  choices:
  - choiceText: Take the Canyon
    successChance: 60
    successOutcome:
      resultText: The shortcut saves fuel
