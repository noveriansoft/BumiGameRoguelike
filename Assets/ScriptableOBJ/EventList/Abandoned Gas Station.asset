%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Abandoned Gas Station
  m_EditorClassIdentifier: 
  eventTitle: Abandoned Gas Station
  description: You find an old gas station, There might still be fuel inside.
  allLevels: 1
  minLevel: 1
  maxLevel: 2
  choices:
  - choiceText: Search the Station
    successChance: 50
    successOutcome:
      resultText: You found some leftover gasoline!
      fuelChange: 10
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The station was picked clean. You wasted time searching and scraped
        the truck on some debris.
      fuelChange: -10
      truckChange: -5
      cargoChange: 0
  - choiceText: Move On
    successChance: 100
    successOutcome:
      resultText: Better not risk it. You keep driving
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: theres no way u fail this bruh
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
  - choiceText: Siphon Fuel from a Wreck
    successChance: 40
    successOutcome:
      resultText: Jackpot! The abandoned vehicle still had usable fuel
      fuelChange: 20
      truckChange: -5
      cargoChange: 0
    failureOutcome:
      resultText: The fuel tank was empty. You only damaged your truck
      fuelChange: 0
      truckChange: -20
      cargoChange: 0
