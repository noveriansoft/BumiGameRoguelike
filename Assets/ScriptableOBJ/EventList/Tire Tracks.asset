  m_Script: {fileID: 11500000, guid: 62c69e51ec7099c478b7b22141c75487, type: 3}
  m_Name: Tire Tracks
  m_EditorClassIdentifier: 
  eventTitle: Tire Tracks
  description: ' You notice fresh tire tracks leading off the main road!'
  allLevels: 0
  minLevel: 1
  maxLevel: 2
  choices:
  - choiceText: Follow the Tracks
    successChance: 50
    successOutcome:
      resultText: You discovered a small abandoned campsite. Whoever was here left
        some fuel behind!
      fuelChange: 15
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: The tracks led nowhere. You wasted fuel searching!
      fuelChange: -15
      truckChange: 0
      cargoChange: 0
  - choiceText: Stay on the Road
    successChance: 60
    successOutcome:
      resultText: You stick to the main route and avoid unnecessary risks
      fuelChange: 0
      truckChange: 0
      cargoChange: 0
    failureOutcome:
      resultText: A pothole damages one of your tires!
      fuelChange: 0
      truckChange: -10
      cargoChange: 0
  - choiceText: Search Nearby
    successChance: 40
    successOutcome:
      resultText: You found a toolbox hidden under some bushes
      fuelChange: 0
      truckChange: 10
      cargoChange: 0
    failureOutcome:
      resultText: You found nothing except a patch of thorns
      fuelChange: 0
      truckChange: -10
      cargoChange: 0
